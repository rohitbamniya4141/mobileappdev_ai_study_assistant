# Copy this file to .env and fill in local values. Never commit .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=study_assistant

# Choose one: openai, ollama (free, local model), or gemini (Google Gemini API)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — add your frontend origins. Android emulator uses 10.0.2.2; physical
# device uses your machine's local IP address.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_SIZE_MB=15

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-running
JWT_EXPIRE_MINUTES=10080

